{
  "expo": {
    "name": "369 Delivery Partner",
    "slug": "369-delivery-partner",
    "scheme": "delivery369",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/splash-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alphalize.deliverypartner",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification",
          "location",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "369 Delivery Partner uses your location to send you nearby orders and to show the customer where you are.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "369 Delivery Partner needs background location so you keep receiving orders and customers can track their delivery while the app is closed.",
        "NSLocationAlwaysUsageDescription": "369 Delivery Partner needs background location so you keep receiving orders while the app is closed."
      }
    },
    "android": {
      "package": "com.alphalize.deliverypartner",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos of the parcel at pickup and at delivery.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "369 Delivery Partner needs background location so you keep receiving orders and customers can track their delivery.",
          "locationWhenInUsePermission": "369 Delivery Partner uses your location to send you nearby orders.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0042B3",
          "sounds": [
            "./assets/sounds/near_customer.wav",
            "./assets/sounds/new_job.wav",
            "./assets/sounds/success.wav",
            "./assets/sounds/wrong.wav",
            "./assets/sounds/job_gone.wav"
          ]
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset",
      "./plugins/withLockScreenRing",
      "./plugins/withPhotoUploadService",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RiderWidget",
              "label": "369 Delivery",
              "description": "Duty, today's deliveries and the job in hand",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc27dcea-c555-454e-8d34-5c43bcf2d90c"
      }
    },
    "owner": "wikike",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cc27dcea-c555-454e-8d34-5c43bcf2d90c"
    }
  }
}
