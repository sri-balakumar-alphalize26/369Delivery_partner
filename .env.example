# Odoo Delivery Partner API — test environment
# The base URL is a Cloudflare quick tunnel and CHANGES whenever it restarts.
# When it does, you do NOT need a rebuild: open the app, Profile ->
# Change connection, paste the new address.
EXPO_PUBLIC_API_URL=https://your-tunnel.trycloudflare.com
EXPO_PUBLIC_ODOO_DB=res-test1

# mock = built-in simulation (default), real = live server
EXPO_PUBLIC_API_MODE=mock

# Who a stuck rider calls. Empty hides the support button entirely.
# Editable in the app too: Profile -> Change connection.
EXPO_PUBLIC_SUPPORT_PHONE=

# OpenRouteService key for the road-following route and ETA on the job map.
# Free, no card: sign up at https://openrouteservice.org/dev/#/signup
# Empty falls back to the straight dashed line, which is what shipped before.
EXPO_PUBLIC_ORS_KEY=
