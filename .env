# Odoo Delivery Partner API — test environment
# The base URL is a Cloudflare quick tunnel and CHANGES whenever it restarts.
# When it does, you do NOT need a rebuild: open the app, Profile ->
# Change connection, paste the new address.
EXPO_PUBLIC_API_URL=https://gnome-phone-author-spots.trycloudflare.com
EXPO_PUBLIC_ODOO_DB=res-test1

# mock = built-in simulation (default), real = live server
EXPO_PUBLIC_API_MODE=mock
