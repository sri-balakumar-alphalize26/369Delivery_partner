<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sa_delivery_settings_form_rider_rpc" model="ir.ui.view">
        <field name="name">sa.delivery.settings.form.rider_rpc</field>
        <field name="model">sa.delivery.settings</field>
        <field name="inherit_id"
               ref="sales_automation_delivery.view_sa_delivery_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='otp_test_mode']]" position="before">
                <group string="Rider offers" colspan="2">
                    <field name="rider_rpc_offer_timeout_min"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
