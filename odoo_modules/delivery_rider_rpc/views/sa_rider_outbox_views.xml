<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sa_rider_outbox_list" model="ir.ui.view">
        <field name="name">sa.rider.outbox.list</field>
        <field name="model">sa.rider.outbox</field>
        <field name="arch" type="xml">
            <list string="Rider App Messages" create="false"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state in ('blocked', 'handed_off')"
                  decoration-muted="state == 'sent'">
                <field name="create_date" string="Queued"/>
                <field name="channel"/>
                <field name="picking_id"/>
                <field name="recipient"/>
                <field name="body"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="next_try" optional="hide"/>
                <field name="last_error" optional="show"/>
                <button name="action_retry" type="object" string="Retry"
                        icon="fa-repeat"
                        invisible="state not in ('failed', 'blocked')"/>
            </list>
        </field>
    </record>

    <record id="view_sa_rider_outbox_form" model="ir.ui.view">
        <field name="name">sa.rider.outbox.form</field>
        <field name="model">sa.rider.outbox</field>
        <field name="arch" type="xml">
            <form string="Rider App Message" create="false">
                <header>
                    <button name="action_retry" type="object" string="Retry"
                            class="btn-primary"
                            invisible="state not in ('failed', 'blocked')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="queued,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="channel"/>
                            <field name="picking_id"/>
                            <field name="session_id"/>
                            <field name="recipient"/>
                        </group>
                        <group>
                            <field name="attempts"/>
                            <field name="next_try"/>
                            <field name="sent_on"/>
                        </group>
                    </group>
                    <field name="body"/>
                    <group string="Last error" invisible="not last_error">
                        <field name="last_error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sa_rider_outbox_search" model="ir.ui.view">
        <field name="name">sa.rider.outbox.search</field>
        <field name="model">sa.rider.outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="recipient"/>
                <field name="picking_id"/>
                <filter name="problems" string="Needs attention"
                        domain="[('state', 'in', ('failed', 'blocked'))]"/>
                <filter name="waiting" string="Waiting"
                        domain="[('state', '=', 'queued')]"/>
                <separator/>
                <filter name="whatsapp" string="WhatsApp"
                        domain="[('channel', '=', 'whatsapp')]"/>
                <filter name="push" string="App push"
                        domain="[('channel', '=', 'push')]"/>
                <group>
                    <filter name="by_state" string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sa_rider_outbox" model="ir.actions.act_window">
        <field name="name">Rider App Messages</field>
        <field name="res_model">sa.rider.outbox</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_problems': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is stuck.</p>
            <p>Messages caused by a rider's step in the app are queued here
               and sent within seconds. Anything that could not be sent after
               five tries, or that WhatsApp refused, is listed with a Retry
               button.</p>
        </field>
    </record>

    <menuitem id="menu_sa_rider_outbox"
              name="Rider App Messages"
              parent="sales_automation_delivery.menu_sa_delivery_ops"
              action="action_sa_rider_outbox"
              sequence="90"/>
</odoo>
