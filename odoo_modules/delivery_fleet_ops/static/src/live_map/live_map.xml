<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="delivery_fleet_ops.LiveMap">
        <div class="o_fleet_live_map d-flex h-100">
            <aside class="o_fleet_panel d-flex flex-column border-end bg-view">
                <div class="p-3 border-bottom">
                    <div class="d-flex align-items-center justify-content-between">
                        <h4 class="m-0">Live map</h4>
                        <button class="btn btn-sm btn-secondary" t-on-click="onRefreshClick" title="Refresh now">
                            <i class="fa fa-refresh"/>
                        </button>
                    </div>
                    <div class="d-flex gap-3 mt-2 small">
                        <span><span class="o_fleet_dot" style="background:#1E8E4E"/> <t t-esc="counts.free"/> free</span>
                        <span><span class="o_fleet_dot" style="background:#F26B1D"/> <t t-esc="counts.busy"/> busy</span>
                        <span><span class="o_fleet_dot" style="background:#9AA1B1"/> <t t-esc="counts.grey"/> not seen</span>
                    </div>
                    <div class="text-muted small mt-1" t-if="updatedLabel">
                        Updated <t t-esc="updatedLabel"/> · every 15 s
                    </div>
                    <div class="alert alert-warning small mt-2 mb-0 py-1" t-if="state.error">
                        <t t-esc="state.error"/> Showing the last picture.
                    </div>
                </div>
                <div class="flex-grow-1 overflow-auto">
                    <div t-if="!state.riders.length" class="p-3 text-muted">
                        No rider is on duty.
                    </div>
                    <t t-foreach="state.riders" t-as="rider" t-key="rider.id">
                        <div t-attf-class="o_fleet_row p-3 border-bottom {{ rider.id === state.selectedId ? 'o_selected' : '' }}"
                             t-on-click="() => this.select(rider.id)">
                            <div class="d-flex align-items-center">
                                <span class="o_fleet_dot me-2" t-attf-style="background:{{ color(rider) }}"/>
                                <strong class="flex-grow-1 text-truncate" t-esc="rider.name"/>
                                <a href="#" class="small" t-on-click.prevent.stop="() => this.openRider(rider.id)">Open</a>
                            </div>
                            <div class="small text-muted mt-1">
                                <t t-esc="statusLabel(rider)"/>
                                <t t-if="rider.vehicle"> · <i class="fa fa-motorcycle"/> <t t-esc="rider.vehicle.plate"/></t>
                                <t t-if="seenLabel(rider)"> · <t t-esc="seenLabel(rider)"/></t>
                                <t t-if="batteryLabel(rider)"> · <i class="fa fa-battery-half"/> <t t-esc="batteryLabel(rider)"/></t>
                            </div>
                            <div t-if="rider.jobs.length" class="small mt-1">
                                <t t-foreach="rider.jobs" t-as="job" t-key="job.id">
                                    <a href="#" class="d-block text-truncate"
                                       t-on-click.prevent.stop="() => this.openJob(job.id)">
                                        <t t-esc="job.ref"/> →
                                        <t t-esc="job.heading === 'shop' ? 'shop' : 'customer'"/>
                                        <t t-if="job.target_name">: <t t-esc="job.target_name"/></t>
                                    </a>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </aside>
            <div class="o_fleet_map flex-grow-1" t-ref="map"/>
        </div>
    </t>
</templates>
