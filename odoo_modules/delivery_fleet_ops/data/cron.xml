<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_fleet_position_purge" model="ir.cron">
        <field name="name">Fleet: forget old rider positions</field>
        <field name="model_id" ref="model_sa_fleet_position"/>
        <field name="state">code</field>
        <field name="code">model._cron_purge()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_fleet_offer_reminder" model="ir.cron">
        <field name="name">Fleet: remind riders of offers about to run out</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_fleet_offer_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_fleet_geocode" model="ir.cron">
        <field name="name">Fleet: put customers and shops on the map</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model._cron_fleet_geocode()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
